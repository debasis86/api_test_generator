{
    "openapi": "3.0.0",
    "info": {
        "title": "Petstore Sample API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://petstore.swagger.io/v2"
        }
    ],
    "paths": {
        "/pet/{petId}": {
            "get": {
                "summary": "Find pet by ID",
                "parameters": [
                    {
                        "name": "petId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "successful operation"
                    },
                    "400": {
                        "description": "Invalid ID supplied"
                    },
                    "404": {
                        "description": "Pet not found"
                    }
                }
            }
        }
    }
}